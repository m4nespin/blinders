{
  "manifest_version": 3,
  "name": "Blinders: Focus Mode for YouTube",
  "version": "1.6.0",
  "description": "Hides Shorts, members-only videos, recommendations, notifications, sidebar sections and Premium upsells on YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "blinders@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["storage"],
  "action": {
    "default_title": "Blinders",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "css": ["blinders.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
